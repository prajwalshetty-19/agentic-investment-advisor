# Application Settings
APP_ENV=development
APP_NAME="Agentic AI Investment Advisor"
DEBUG=True
SECRET_KEY=generate_a_secure_jwt_secret_key_here_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Virtual Trading Defaults
DEFAULT_VIRTUAL_BALANCE=100000.00
DEFAULT_CURRENCY=INR

# Database
DATABASE_URL=sqlite:///./data/advisor.db

# Multi-Agent & LLM Configuration
# Primary LLM provider (GEMINI or OPENAI or MOCK)
LLM_PROVIDER=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Search & Data APIs (Graceful local fallback if omitted)
TAVILY_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Server Ports
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000
